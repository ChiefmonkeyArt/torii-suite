#!/usr/sbin/nft -f
add table inet torii_fips
flush table inet torii_fips
table inet torii_fips {
  chain input {
    type filter hook input priority -10; policy accept;
    iifname != "fips0" return
    ct state established,related accept
    meta nfproto ipv6 icmpv6 type echo-request limit rate 5/second accept
    tcp dport 7778 accept
    jump members
    counter drop
  }
  # Per-service allow lists (for example Teams git) from fips.d drop-ins.
  chain members {
  }
  chain forward {
    type filter hook forward priority -10; policy accept;
    iifname "fips0" drop
    oifname "fips0" drop
  }
}
include "/etc/torii/fips/fips.d/*.nft"
